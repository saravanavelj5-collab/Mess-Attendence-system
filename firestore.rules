rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for unhandled documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document (for initial health check)
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users collection (students, managers, admins)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Attendance records (daily meal availability)
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }
  }
}
